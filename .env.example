# Copy this file to .env and fill in values before running docker-compose.
# .env is in .gitignore — never commit real secrets.

# HMAC key for PHI field masking. Use a strong random value in production
# (e.g. `openssl rand -hex 32`). Required — the producer will refuse to start
# without this.
PII_HASH_KEY=local-dev-key-change-before-production
